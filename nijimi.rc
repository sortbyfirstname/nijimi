#pragma code_page(65001)
#include "version.rh"

1 ICON "assets/tresbient.ico"

1 VERSIONINFO
FILEVERSION NIJIMI_VERSION
PRODUCTVERSION NIJIMI_VERSION
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Aaron Seabrook"
            VALUE "FileDescription", "nijimi"
            VALUE "FileVersion", NIJIMI_VERSION_STRING
            VALUE "InternalName", "nijimi"
            VALUE "LegalCopyright", "© 2026 Aaron Seabrook"
            VALUE "OriginalFilename", "nijimi.exe"
            VALUE "ProductName", "nijimi"
            VALUE "ProductVersion", NIJIMI_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
